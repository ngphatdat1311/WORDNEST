{
  "name": "wordnest",
  "version": "2.2.4",
  "description": "WordNest 2.0 – Ứng dụng học từ vựng SRS & Nghe chép chính tả YouTube chuẩn DOL (Desktop App & Web/PWA).",
  "main": "electron/main.js",
  "author": "ngphatdat1311",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:electron": "next build && node scripts/prepare-electron.mjs",
    "start": "electron .",
    "start:web": "next start",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "node scripts/e2e-verify.mjs",
    "dist": "npm run build:electron && electron-builder",
    "dist:dir": "npm run build:electron && electron-builder --dir"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "electron-updater": "^6.8.9",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.77.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "playwright-core": "^1.65.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  },
  "build": {
    "appId": "com.wordnest.app",
    "productName": "WordNest",
    "files": [
      "electron/**",
      "assets/**",
      "package.json",
      "!extension/**",
      "!src/**",
      "!.next/**",
      "!node_modules/{next,@next,@img,sharp,react,react-dom,framer-motion,lucide-react,zustand,canvas-confetti}/**"
    ],
    "afterPack": "scripts/after-pack.cjs",
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone",
        "filter": [
          "**/*",
          "!.env*"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "ngphatdat1311",
        "repo": "WORDNEST"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "assets/icons/icon-512.png",
      "category": "public.app-category.education"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icons/icon-512.png",
      "category": "Education",
      "executableName": "wordnest",
      "maintainer": "ngphatdat1311 <ngphatdat1311@users.noreply.github.com>"
    }
  }
}
